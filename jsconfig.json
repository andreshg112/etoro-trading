{
    "compilerOptions": {
        "checkJs": true,
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020"
        ]
    },
    "include": [
        "*.js"
    ],
    "exclude": [
        "node_modules",
        "tests"
    ]
}
